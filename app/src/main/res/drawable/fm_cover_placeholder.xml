<?xml version="1.0" encoding="utf-8"?>
<!-- Bento cover placeholder: pastel square with the radio glyph, used when a station has no art. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="240dp" android:height="240dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bento_tile_orange_bg" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="88dp" android:height="88dp" android:drawable="@drawable/ic_fm_radio_orange" />
</layer-list>
