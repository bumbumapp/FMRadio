<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bento_surface"
    android:orientation="vertical"
    tools:context=".presentation.settings.SettingsActivity">
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/bento_surface"
        app:contentInsetStart="16dp">
        <ImageView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fm_square_btn"
            android:contentDescription="@string/settings"
            android:padding="12dp"
            android:src="@drawable/ic_base_arrow"
            android:tint="@color/fm_fg"
            android:layout_marginEnd="14dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textAppearance="@style/Bento.Text.Headline"
            android:textColor="@color/fm_fg"
            android:textSize="26sp">

        </TextView>

    </androidx.appcompat.widget.Toolbar>
    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>