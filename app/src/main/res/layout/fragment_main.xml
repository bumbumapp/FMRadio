<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bento_surface"
    android:orientation="vertical"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/fm_tabs_bg"
        android:padding="4dp">
        <com.google.android.material.tabs.TabLayout
        android:id="@+id/mainTl"
        style="@style/RadioTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
                app:tabGravity="fill"
        app:tabIndicator="@drawable/fm_tab_indicator"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/bento_primary"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabBackground="@null"
        android:background="@null"
        app:tabSelectedTextColor="@color/bento_onPrimary"
        app:tabTextColor="@color/fm_fg2"
        />
    </FrameLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/mainPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bento_surface"
        />

</LinearLayout>