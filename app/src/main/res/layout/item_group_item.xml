<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:background="@drawable/bg_item_middle"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    tools:ignore="UnusedAttribute">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:background="@drawable/bento_icon_square"
        android:backgroundTint="@color/bento_tile_orange_bg"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_fm_radio"
        android:tint="@color/bento_tile_orange_fg" />


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"

        >

        <TextView
            android:id="@+id/nameTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingLeft="14dp"
            android:textColor="@color/fm_fg"
            android:maxLines="1"
            android:textAppearance="@style/Bento.Text.TileLabel"
            android:textStyle="bold"
            tools:text="Item name"
            />

        <TextView
            android:id="@+id/specsTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingRight="8dp"
            android:paddingLeft="14dp"
            android:textColor="@color/fm_fg2"
            android:textAppearance="@style/Bento.Text.BodySmall"
            tools:text="Item name"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:background="@color/divider"
            >

        </View>
    </LinearLayout>


    <ImageView
        android:id="@+id/handleIv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?actionBarItemBackground"
        android:padding="12dp"
        android:src="@drawable/ic_handle"
        tools:ignore="ContentDescription"
        />

</LinearLayout>
