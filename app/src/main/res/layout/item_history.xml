<?xml version="1.0" encoding="utf-8"?>
<!-- Bento history row inside a grouped card (background set by the adapter). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:background="@drawable/bg_item_middle"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bento_icon_square"
        android:backgroundTint="@color/bento_tile_orange_bg"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_fm_radio"
        android:tint="@color/bento_tile_orange_fg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Bento.Text.TileLabel"
            tools:text="Item name" />

        <TextView
            android:id="@+id/subtitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Bento.Text.BodySmall"
            tools:text="Music, Rock" />
    </LinearLayout>
</LinearLayout>
