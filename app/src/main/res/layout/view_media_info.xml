<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingTop="36dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    >
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fmHeroCard"
        style="@style/Bento.Hero"
        android:layout_width="0dp"
        android:layout_height="140dp"
        app:cardBackgroundColor="@color/bento_hero"
        app:cardCornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bento_hero_circle"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_fm_radio"
                app:tint="@color/bento_onHero" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="64dp"
                android:layout_gravity="end|center_vertical"
                android:importantForAccessibility="no"
                android:src="@drawable/fm_wave" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:background="@drawable/fm_live_chip"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/bento_live"
                android:textAppearance="@style/Bento.Text.Label"
                android:textColor="@color/bento_onHero" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/dateTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textAppearance="@style/Bento.Text.Body"
        tools:text="Record create date"
        app:layout_constraintTop_toBottomOf="@id/fmHeroCard"
        android:layout_marginTop="18dp"
        android:drawableStart="@drawable/ic_date"
        app:drawableTint="@color/bento_primary"
        android:drawablePadding="8dp"
        android:textColor="@color/fm_fg"
        android:drawableLeft="@drawable/ic_date"
        />

    <TextView
        android:id="@+id/groupTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textAppearance="@style/Bento.Text.Body"
        tools:text="Station group"
        app:layout_constraintTop_toBottomOf="@id/dateTv"
        android:drawableStart="@drawable/ic_group"
        app:drawableTint="@color/bento_primary"
        android:textColor="@color/fm_fg"
        android:drawablePadding="8dp"
        android:drawableLeft="@drawable/ic_group"
        />

    <TextView
        android:id="@+id/genreTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/fm_fg"
        android:textAppearance="@style/Bento.Text.Body"
        app:layout_constraintTop_toBottomOf="@id/groupTv"
        tools:text="Station genre"
        android:drawableStart="@drawable/ic_genre"
        app:drawableTint="@color/bento_primary"
        android:drawablePadding="8dp"
        android:drawableLeft="@drawable/ic_genre"
        />

    <TextView
        android:id="@+id/specsTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/fm_fg"
        android:textAppearance="@style/Bento.Text.Body"
        app:layout_constraintTop_toBottomOf="@id/genreTv"
        tools:text="22100 kHz, 128 kbps"
        android:drawableStart="@drawable/settings_ic"
        app:drawableTint="@color/bento_primary"
        android:drawablePadding="8dp"
        android:drawableLeft="@drawable/settings_ic"
        />

    <TextView
        android:id="@+id/locationTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/fm_fg"
        android:textAppearance="@style/Bento.Text.Body"
        app:layout_constraintTop_toBottomOf="@id/specsTv"
        tools:text="Station location"
        android:drawableStart="@drawable/ic_lang"
        app:drawableTint="@color/bento_primary"
        android:drawablePadding="8dp"
        android:drawableLeft="@drawable/ic_lang"
        />

    <TextView
        android:id="@+id/websiteTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textAppearance="@style/Bento.Text.Body"
        app:layout_constraintTop_toBottomOf="@id/locationTv"
        tools:text="Station website"
        android:drawableStart="@drawable/ic_globe"
        app:drawableTint="@color/bento_primary"
        android:drawablePadding="8dp"
        android:textColor="@color/fm_fg"
        android:drawableLeft="@drawable/ic_globe"
        />

    <ImageButton
        android:id="@+id/addShortcutBt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/fm_square_btn_alt"
        android:tint="@color/fm_fg"
        android:contentDescription="@string/desc_create_shortcut_button"
        android:foreground="?actionBarItemBackground"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_label_plus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/equalizerBt"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="UnusedAttribute"
        />

    <ImageButton
        android:id="@+id/equalizerBt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/fm_square_btn_alt"
        android:tint="@color/fm_fg"
        android:contentDescription="@string/desc_equalizer"
        android:foreground="?actionBarItemBackground"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_equalizer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/recordBt"
        app:layout_constraintStart_toEndOf="@+id/addShortcutBt"
        tools:ignore="UnusedAttribute"
        />

    <ImageButton
        android:id="@+id/recordBt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/fm_square_btn_alt"
        android:tint="@color/fm_fg"
        android:contentDescription="@string/desc_record"
        android:foreground="?actionBarItemBackground"
        android:scaleType="fitCenter"
        android:padding="14dp"
        android:src="@drawable/ic_recorder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/equalizerBt"
        tools:ignore="UnusedAttribute"
        />

</androidx.constraintlayout.widget.ConstraintLayout>