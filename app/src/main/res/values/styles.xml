<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.Bento">
        <item name="android:windowLightStatusBar">@bool/fm_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/fm_light_bars</item>
        <item name="autoCompleteTextViewStyle">@style/SearchAutoCompleteTextView</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="tabStyle">@style/RadioTabs</item>
        <item name="colorAccent">@color/bento_primary</item>
        <item name="colorPrimaryDark">@color/bento_surface</item>
        <item name="android:statusBarColor">@color/bento_surface</item>
        <item name="android:navigationBarColor">@color/bento_surface</item>
    </style>

    <!-- Sentence-case tabs with a slim accent indicator. -->
    <style name="RadioTabs" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/RadioTabText</item>
        <item name="tabIndicatorColor">@color/radio_accent</item>
    </style>

    <style name="RadioTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="AppTheme.Splash">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar"/>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light"/>

    <style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">@color/bento_surfaceContainerLowest</item>
    </style>
    <style name="MySeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressBackgroundTint">@color/bento_outline</item>
        <item name="android:progressTint">@color/bento_primary</item>
        <item name="android:thumbTint">@color/radio_accent</item>
    </style>
    <style name="MySeekBarSettings" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressBackgroundTint">@color/bento_outline</item>
        <item name="android:progressTint">@color/bento_primary</item>
        <item name="android:thumbTint">@color/bento_primary</item>
    </style>

    <style name="spinnerTheme">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SearchAutoCompleteTextView" parent="Widget.AppCompat.Light.AutoCompleteTextView">
        <item name="android:textColor">@color/fm_fg</item>
        <item name="android:textColorHint">@color/fm_fg_hint</item>
        <item name="colorButtonNormal">@color/fm_fg</item>
        <item name="iconTint">@color/fm_fg</item>
        <item name="searchIcon">@drawable/ic_search</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="android:shadowColor">@color/fm_fg</item>
        <item name="android:strokeColor">@color/fm_fg</item>
        <item name="colorSecondary" tools:targetApi="n_mr1">@color/fm_fg</item>
        <item name="android:outlineSpotShadowColor">@color/fm_fg</item>
        <item name="android:outlineAmbientShadowColor">@color/fm_fg</item>
    </style>




</resources>
