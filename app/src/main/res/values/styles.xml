<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/pause</item>
        <item name="colorPrimaryDark">@color/dark_color</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/radio_accent</item>
        <item name="colorSecondaryVariant">@color/white</item>
        <item name="colorOnSecondary">#96FFFFFF</item>
        <item name="colorSurface">#F4E8E8</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="autoCompleteTextViewStyle">@style/SearchAutoCompleteTextView</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="tabStyle">@style/RadioTabs</item>
        <item name="textAppearanceButton">@style/RadioTabText</item>
    </style>

    <!-- Sentence-case tabs with a slim accent indicator. -->
    <style name="RadioTabs" parent="Widget.MaterialComponents.TabLayout.Colored">
        <item name="tabTextAppearance">@style/RadioTabText</item>
        <item name="tabIndicatorColor">@color/radio_accent</item>
    </style>

    <style name="RadioTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="AppTheme.Splash">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar"/>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light"/>

    <style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">@color/white</item>
    </style>
    <style name="MySeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressBackgroundTint">#FFFFFF</item>
        <item name="android:progressTint">@color/white</item>
        <item name="android:thumbTint">@color/radio_accent</item>
    </style>
    <style name="MySeekBarSettings" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressBackgroundTint">#E1D0D0</item>
        <item name="android:progressTint">@color/blue_500</item>
        <item name="android:thumbTint">@color/dark_color</item>
    </style>

    <style name="spinnerTheme">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SearchAutoCompleteTextView" parent="Widget.AppCompat.Light.AutoCompleteTextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="colorButtonNormal">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="searchIcon">@drawable/ic_search</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="android:shadowColor">@color/white</item>
        <item name="android:strokeColor">@color/white</item>
        <item name="colorSecondary" tools:targetApi="n_mr1">@color/white</item>
        <item name="android:outlineSpotShadowColor">@color/white</item>
        <item name="android:outlineAmbientShadowColor">@color/white</item>
    </style>




</resources>
